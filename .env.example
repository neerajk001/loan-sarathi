# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/loan-sarathi

# Backend Server
PORT=5000
NODE_ENV=development

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-change-in-production-min-32-characters

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email Service (Choose one: Resend, SendGrid, or AWS SES)
# RESEND_API_KEY=your-resend-api-key
# SENDGRID_API_KEY=your-sendgrid-api-key
# AWS_SES_REGION=us-east-1
# AWS_SES_ACCESS_KEY_ID=your-access-key
# AWS_SES_SECRET_ACCESS_KEY=your-secret-key

# Email Configuration
EMAIL_FROM=noreply@loansarathi.com
EMAIL_ENABLED=false

# Frontend Public Variables
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_NEWS_API_KEY=your-news-api-key

# Application URLs
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Production domains (comma-separated)
ALLOWED_ORIGINS=https://loansarathi.com,https://www.loansarathi.com,https://smartsolutionsmumbai.com,https://www.smartsolutionsmumbai.com
