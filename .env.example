# Environment Variables Template
# Copy this file to .env.local and fill in your values

# ================================
# REQUIRED: MongoDB Connection
# ================================
# Get from MongoDB Atlas: https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/loan-sarathi
MONGO_URI=

# ================================
# REQUIRED: NextAuth Configuration
# ================================
# Your application URL
NEXTAUTH_URL=http://localhost:3000

# Generate a random secret: openssl rand -base64 32
NEXTAUTH_SECRET=

# ================================
# REQUIRED: Google OAuth
# ================================
# Get from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ================================
# OPTIONAL: Email Service
# ================================
# Uncomment and fill if you want to enable email notifications
# Option 1: Resend (recommended) - https://resend.com
# RESEND_API_KEY=re_xxxxxxxxxxxxx

# Option 2: SendGrid - https://sendgrid.com
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxx

# ================================
# OPTIONAL: Application Settings
# ================================
# Base URL for email links (defaults to http://localhost:3000)
# NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ================================
# NOTES
# ================================
# 1. Never commit .env.local to git
# 2. For production, update NEXTAUTH_URL to your domain
# 3. MongoDB URI should use production cluster for production
# 4. Email service is optional but recommended for production
